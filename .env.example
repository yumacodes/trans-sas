# Base URL of the management system (trans-sas-mgt) API, including /api/v1.
# The website uses only its /public routes: the product catalogue and product requests.
# The API must list this website's origin in WEBSITE_ORIGINS.
# Leave empty to run offline with the bundled catalogue (requests then open an email).
VITE_API_URL=http://localhost:4000/api/v1
